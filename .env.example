# ═══════════════════════════════════════════════════════════
# Atrium — Environment Variables
# ═══════════════════════════════════════════════════════════
# Only DATABASE_URL and BETTER_AUTH_SECRET are required.
# Everything else has sensible defaults for local development.
# For Docker deployments, see: docs/configuration.md

# ── Required ──────────────────────────────────────────────

DATABASE_URL="postgresql://atrium:atrium@localhost:5432/atrium?schema=public"
BETTER_AUTH_SECRET="change-me-in-production-min-32-chars"

# ── Optional ──────────────────────────────────────────────

# Public app URL. Required in production; defaults to localhost:3000 in dev.
# WEB_URL="http://localhost:3000"

# ── Split deployments only (web and API run separately) ───
# The Docker image sets these. See docs/configuration.md#required-for-split-deployments

# API_URL="https://api.example.com"            # API's public address
# INTERNAL_API_URL="http://atrium-api:3001"    # API's private address; the web app won't start without it in production
# NEXT_PUBLIC_API_URL="https://api.example.com" # address browsers use; empty = same origin

# Direct DB connection for migrations (bypasses PgBouncer/pooler)
# DIRECT_URL=""

# Storage: local (default) | s3 | minio | r2
# STORAGE_PROVIDER="local"
# UPLOAD_DIR="./uploads"
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET="atrium"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Email (Resend) — optional, setup wizard handles this if unset
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# File upload limit
# MAX_FILE_SIZE_MB="50"

# ── Billing (optional) ───────────────────────────────────

# BILLING_ENABLED="false"
# STRIPE_MODE="test"
# STRIPE_TEST_SECRET_KEY=""
# STRIPE_TEST_PUBLISHABLE_KEY=""
# STRIPE_TEST_WEBHOOK_SECRET=""
# STRIPE_TEST_PRO_PRICE_ID=""
# STRIPE_TEST_LIFETIME_PRICE_ID=""
# STRIPE_LIVE_SECRET_KEY=""
# STRIPE_LIVE_PUBLISHABLE_KEY=""
# STRIPE_LIVE_WEBHOOK_SECRET=""
# STRIPE_LIVE_PRO_PRICE_ID=""
# STRIPE_LIVE_LIFETIME_PRICE_ID=""

# ── Stripe Connect (optional — enables client invoice payments) ──
# STRIPE_CONNECT_CLIENT_ID=""           # Platform Connect client ID (ca_xxx)
# STRIPE_CONNECT_WEBHOOK_SECRET=""      # Webhook secret for Connect events
# STRIPE_CURRENCY="usd"                 # Currency for invoice payments (ISO 4217)

# ── Analytics / Tracking (optional) ─────────────────────
# JSON array of script tags. Each object's keys become attributes on a <script> tag.
# Supports any tracker (Umami, Plausible, Fathom, etc.) — add as many as you need.
# ATRIUM_TRACKERS='[{"src":"https://umami.example.com/script.js","data-website-id":"your-id"}]'

# ── Error Reporting / Sentry (optional) ──────────────────────────────────────
# DSNs are baked in by the Atrium team when building the distribution image.
# Self-hosters: if the DSNs are present, the dashboard will show a consent banner
# asking the owner to opt in before any data is sent.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx  # Web app errors (client + SSR)
# SENTRY_DSN=https://xxx@sentry.io/xxx              # API server errors
# SENTRY_AUTH_TOKEN=sntrys_xxx                      # Source map uploads (build-time only)
#
# Hosted deployments only — bypasses the consent banner (you own the server):
# NEXT_PUBLIC_SENTRY_ENABLED=true
# SENTRY_ENABLED=true

# ── Advanced ──────────────────────────────────────────────

# Skip schema sync on startup (for pooled DB connections that block migrations)
# SKIP_DB_PUSH="false"

# Cookie security flag. Unset, it follows the public URL: off when WEB_URL (or
# API_URL) starts with http://, otherwise on in production. Set it only to force
# either way. Over plain HTTP, passwords and sessions travel unencrypted; see
# docs/docker.md#running-over-plain-http. HTTPS (Caddy, nginx, Traefik,
# Cloudflare Tunnel) is strongly recommended.
# SECURE_COOKIES="true"

# Firebase Hosting cookie workaround (only for Firebase CDN deployments)
# FIREBASE_HOSTING="false"

# Rate limiting (requests per minute)
# Raise these for e2e test runs to avoid cascading 429s
# THROTTLE_LIMIT="100"
# SIGNUP_THROTTLE_LIMIT="5"

# Set to "false" to disable public self-serve signup. No new account can be
# created unless a pending invitation exists for that email address, so login
# and invited-client onboarding keep working. Applies to every route that can
# create a user, including social sign-in. Default: signups enabled.
# ALLOW_SIGNUPS="true"

# Lets MCP clients (claude.ai, ChatGPT, Claude Code, Cursor) connect by signing
# in instead of pasting an API key. Requires a public HTTPS URL. API keys work
# regardless of this setting. Setting it to "false" also rejects access tokens
# that were already issued. Default: enabled.
# MCP_OAUTH_ENABLED="true"

# Integrations (Slack, Discord, webhooks) refuse URLs that resolve to private,
# loopback or link-local addresses. Set to "true" on self-hosted installs that
# need to reach an internal service such as n8n on your LAN; this also allows
# plain http:// webhook URLs in production. Default: false.
# INTEGRATIONS_ALLOW_PRIVATE_URLS="false"

# LOG_LEVEL="info"

# Days of Pro a new hosted workspace gets before dropping to Free (0 disables the trial)
TRIAL_DAYS=14
