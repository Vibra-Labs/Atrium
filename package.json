{
  "name": "atrium",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run scripts/dev.ts",
    "test": "turbo run test",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:integration:ci": "turbo run test:integration",
    "test:e2e": "bunx playwright test --config=e2e/playwright.config.ts",
    "test:all": "bun run test && bun run test:integration && bun run test:e2e",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "bun run --filter @atrium/database db:migrate",
    "db:migrate:deploy": "bun run --filter @atrium/database db:migrate:deploy",
    "db:seed": "bun run --filter @atrium/database db:seed",
    "db:rls": "bun run --filter @atrium/database db:rls",
    "clean": "turbo run clean",
    "setup": "bun run scripts/setup.ts",
    "script:disable-2fa": "bun run --cwd apps/api script:disable-2fa"
  },
  "packageManager": "bun@1.3.9",
  "overrides": {
    "minimatch": "^11.0.5",
    "serialize-javascript": ">=7.0.3",
    "ajv": ">=8.18.0",
    "kysely": "^0.28.17",
    "fast-xml-parser": ">=5.5.7",
    "brace-expansion": "^5.0.12",
    "defu": "^6.1.7",
    "hono": "^4.13.13",
    "fast-copy": "^4.2.0",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.31",
    "fast-uri": "^3.1.6",
    "path-to-regexp": "^8.4.2",
    "lodash": "^4.18.1",
    "qs": "^6.16.1",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "source-map-js": "^1.2.2",
    "baseline-browser-mapping": "^2.11.31",
    "browserslist": "^4.29.4",
    "postcss-selector-parser": "^6.1.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "glob": "^14.0.4",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.2",
    "yaml": "^1.10.3",
    "zod": "^4.6.7",
    "@babel/core": "^7.29.13",
    "@hono/node-server": "^2.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "otplib": "^13.4.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sentry/nestjs": "^10.78.0",
    "@sentry/nextjs": "^10.78.0"
  }
}
